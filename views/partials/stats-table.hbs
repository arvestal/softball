<div class="table-wrap">
  <table class="stats-table">
    <thead>
      <tr>
        {{#each columns}}
          <th>{{label}}</th>
        {{/each}}
      </tr>
    </thead>
    <tbody>
      {{#each players as |player|}}
        <tr>
          {{#each ../columns as |col|}}
            <td>
              {{#if col.rate}}{{number3 (lookup player col.field)}}{{else}}{{lookup player col.field}}{{/if}}
            </td>
          {{/each}}
        </tr>
      {{else}}
        <tr><td colspan="21">No stats available.</td></tr>
      {{/each}}
    </tbody>
  </table>
</div>
