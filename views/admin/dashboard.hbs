<section class="admin-page">
  <h1>Admin</h1>
  <p class="section-meta">Signed in as {{adminEmail}} — <a href="/admin/logout">log out</a></p>

  {{#if uploadError}}
  <p class="admin-error">{{uploadError}}</p>
  {{/if}}

  <form class="admin-upload" action="/admin/photos" method="post" enctype="multipart/form-data">
    <input type="file" name="photo" accept="image/*" required>
    <input type="text" name="alt" placeholder="Alt text (optional, can add later)">
    <button type="submit" class="btn">Upload photo</button>
  </form>

  <p class="section-meta">{{photos.length}} photos</p>

  <div class="admin-grid">
    {{#each photos}}
    <div class="admin-photo">
      <img src="{{thumb}}" alt="{{alt}}" loading="lazy">
      <form class="admin-alt-form" action="/admin/photos/{{slug}}" method="post">
        <input type="text" name="alt" value="{{alt}}" placeholder="Alt text">
        <button type="submit">Save</button>
      </form>
      <form action="/admin/photos/{{slug}}/delete" method="post">
        <button type="submit" class="admin-delete">Delete</button>
      </form>
    </div>
    {{/each}}
  </div>
</section>
