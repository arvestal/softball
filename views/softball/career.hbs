<header class="section-header">
  <div class="section-header-top">
    <p class="section-meta">
      Career: {{totals.wins}} &minus; {{totals.losses}} &minus; {{totals.ties}}
    </p>
    {{#if championships}}
    <div class="career-banners">
      {{#each championships}}
      <div class="career-banner">
        <span class="career-banner-season">{{label}} {{year}}</span>
        <span class="career-banner-record">{{wins}}&minus;{{losses}}{{#if ties}}&minus;{{ties}}{{/if}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{> stats-table columns=columns players=careerPlayers}}
</header>

<section class="section-body">
  {{> schedule-table games=games}}
</section>
